{
  "name": "agent-complete",
  "displayName": "Agent Complete",
  "description": "Cmd+E 生成 LaTeX 公式、代码补全（DeepSeek Chat / FIM）。",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentComplete.trigger",
        "title": "生成（公式/补全）",
        "category": "Agent Complete"
      },
      {
        "command": "agentComplete.triggerInline",
        "title": "生成行内公式",
        "category": "Agent Complete"
      },
      {
        "command": "agentComplete.triggerDisplay",
        "title": "生成行间公式",
        "category": "Agent Complete"
      },
      {
        "command": "agentComplete.setApiKey",
        "title": "设置 DeepSeek API Key",
        "category": "Agent Complete"
      }
    ],
    "keybindings": [
      {
        "command": "agentComplete.trigger",
        "key": "ctrl+alt+enter",
        "mac": "cmd+e",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Agent Complete",
      "properties": {
        "agentComplete.model": {
          "type": "string",
          "enum": [
            "deepseek-flash",
            "deepseek-v4-pro"
          ],
          "default": "deepseek-flash",
          "description": "DeepSeek 模型。flash 快且便宜，v4-pro 更强但更贵更慢。"
        },
        "agentComplete.reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "high",
            "max"
          ],
          "default": "max",
          "description": "思考强度：none = 非思考模式（快）；low/high/max = 开启思考，越高质量越好但越慢越贵；默认 max（质量优先）。"
        },
        "agentComplete.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL。"
        },
        "agentComplete.maxTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 64,
          "maximum": 16384,
          "description": "单次生成最多输出 token 数（思考模式需要给推理留空间，默认 8192）。"
        },
        "agentComplete.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "采样温度；思考模式下该参数不生效。"
        },
        "agentComplete.timeoutMs": {
          "type": "number",
          "default": 90000,
          "minimum": 1000,
          "description": "单次请求超时时间（毫秒）；max 思考档较慢，默认 90s。"
        },
        "agentComplete.contextTokens": {
          "type": "number",
          "default": 32000,
          "minimum": 1000,
          "maximum": 128000,
          "description": "上下文预算（估算 token 数，按 3.5 字符/token 换算成字符）。"
        },
        "agentComplete.formulaStyle": {
          "type": "string",
          "enum": [
            "auto",
            "inline",
            "display"
          ],
          "default": "auto",
          "description": "公式样式：auto 按光标/选区自动判断，inline 强制行内，display 强制行间。"
        },
        "agentComplete.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "markdown",
            "latex",
            "tex",
            "python"
          ],
          "description": "允许触发补全的语言 id 列表。"
        },
        "agentComplete.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env",
            "**/.env.*",
            "**/*secret*",
            "**/*.pem",
            "**/*.key"
          ],
          "description": "命中这些 glob 的文件不会上传代码（相对工作区路径匹配）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bench": "node scripts/bench.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
